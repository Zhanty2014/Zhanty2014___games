{
  "帮助": {
    "program": [
      { "op": "say", "text": "========== 命令表 ==========" },
      { "op": "say", "text": "提示：选中台面物品后，下方会自动出现可用动作（洗/切/炒/煮）！" },
      { "op": "say", "text": "早市：买 菜刀 / 铁锅 / 土豆 / 大米 / 番茄 / 鸡蛋 / 茶叶" },
      { "op": "say", "text": "储物间：接水" },
      { "op": "say", "text": "厨房：研发 / 装盘" },
      { "op": "say", "text": "餐厅：来客 / 出餐" }
    ]
  },
  "看": { "program": [ { "op": "say", "text": "{room.desc}" } ] },
  "背包": { "program": [ { "op": "say", "text": "背包：{inventory}" } ] },
  "钱": { "program": [ { "op": "say", "text": "当前余额：{money} 元" } ] },
  
  "放上台面": {
    "needTarget": true,
    "program": [ { "op": "place" } ]
  },
  "收起": {
    "needTarget": true,
    "program": [ { "op": "pick" } ]
  },

  "研发": {
    "room": "kitchen",
    "program": [ { "op": "research" } ]
  },
  "装盘": {
    "room": "kitchen",
    "program": [ { "op": "craft" } ]
  },
  
  "出餐": {
    "room": "dining",
    "needTarget": true,
    "program": [ { "op": "say", "text": "这个出餐逻辑由 UI 特殊接管。" } ]
  },
  
  "来客": { 
    "program": [ { "op": "spawn", "npc": "random" } ] 
  },
  
  "接水": {
    "room": "storage",
    "program": [
      { "op": "give", "item": "water" },
      { "op": "say", "text": "你在储物间的水龙头下接了一瓢生水，放进了背包。" }
    ]
  }
}
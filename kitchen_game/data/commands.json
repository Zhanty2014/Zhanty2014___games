{
  "帮助": {
    "program": [
      { "op": "say", "text": "========== 命令表 ==========" },
      { "op": "say", "text": "场景动作：研发 / 洗 / 切 / 炒 / 装盘" },
      { "op": "say", "text": "提示：在早市点击商品购买，点击背包食材放上台面！" }
    ]
  },
  "看": { "program": [ { "op": "say", "text": "{room.desc}" } ] },
  "背包": { "program": [ { "op": "say", "text": "背包：{inventory}" } ] },
  "钱": { "program": [ { "op": "say", "text": "当前余额：{money} 元" } ] },
  
  "放上台面": {
    "needTarget": true,
    "program": [ { "op": "place" } ]
  },
    "收起": {
    "needTarget": true,
    "program": [ { "op": "pick" } ]
  },

  "研发": {
    "room": "kitchen",
    "isSceneAction": true,
    "program": [ { "op": "research" } ]
  },
  "洗": {
    "room": "kitchen",
    "isSceneAction": true,
    "needTarget": true,
    "program": [
      { "op": "if", "cond": { "target.state": "raw" },
        "then": [
          { "op": "say", "text": "水龙头哗啦啦，你把{target.name}洗干净了。" },
          { "op": "set", "path": "target.state", "value": "washed" }
        ],
        "else": [ { "op": "say", "text": "{target.name}现在不需要洗。" } ] }
    ]
  },
  "切": {
    "room": "kitchen",
    "isSceneAction": true,
    "requireTools": ["knife"],
    "needTarget": true,
    "program": [
      { "op": "if", "cond": { "target.state": "raw" },
        "then": [ { "op": "say", "text": "{target.name}还带着泥，先去洗洗。" } ],
        "else": [
          { "op": "if", "cond": { "target.state": "washed" },
            "then": [
              { "op": "say", "text": "咔嚓——{target.name}切好了。" },
              { "op": "set", "path": "target.state", "value": "chopped" }
            ],
            "else": [ { "op": "say", "text": "{target.name}现在不需要切。" } ] }
        ] }
    ]
  },
  "炒": {
    "room": "kitchen",
    "isSceneAction": true,
    "requireTools": ["pan"],
    "needTarget": true,
    "program": [
      { "op": "if", "cond": { "target.state": "chopped" },
        "then": [
          { "op": "say", "text": "你把{target.name}倒进锅里，油花滋啦响……" },
          { "op": "wait", "sec": 3, "then": [
            { "op": "say", "text": "叮！{target.name}炒熟了，香气扑鼻。" },
            { "op": "set", "path": "target.state", "value": "cooked" }
          ] }
        ],
        "else": [ { "op": "say", "text": "{target.name}还没切好，不能下锅。" } ] }
    ]
  },
  "装盘": {
    "room": "kitchen",
    "isSceneAction": true,
    "program": [ { "op": "craft" } ]
  },
  "出餐": {
    "room": "dining",
    "needTarget": true,
    "program": [
      { "op": "if", "cond": { "target.state": "dish" },
        "then": [
          { "op": "say", "text": "你把{target.name}端给了顾客。" },
          { "op": "add", "path": "money", "value": 30 },
          { "op": "remove", "from": "table" }
        ],
        "else": [ { "op": "say", "text": "这不是成品菜，不能出餐。" } ] }
    ]
  },
  "来客": { "program": [ { "op": "spawn", "npc": "customer_1" } ] }
}